<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="style.css">
    <title>Kiyotai</title>
  </head>
  <body>
    <nav>
      <span>kiyotai</span>
      <span>home</span>
      <span>career</span>
      <span>info</span>
      <span>support</span>
      <span><button>lang:ENG</button></span>
    </nav>
    
    <h1>Kiyotai Posts</h1>
    <hr><hr>
    <a href="http://localhost:8000/posts/new"><button>New User</button></a>
    <% for(post of posts) {%>
        <div class="users">
            <h3 class="user"> @<%=post.username%> </h3>
            <h5 class="content"> <%=post.content%> </h5>
            <span>
                <button class="btn1">Follow</button>
                <a href="http://localhost:8000/posts/<%=post.id%>"><button class="btn1">View</button></a>
                <a href="http://localhost:8000/posts/<%=post.id%>/edit"><button class="btn1">Edit</button></a>
                <form method="post" action="/posts/<%=post.id%>?_method=DELETE"><button>Delete</button></form>
            </span>
            <br>
        </div>

        <%}%>

        <center></center>

  </body>
</html>
