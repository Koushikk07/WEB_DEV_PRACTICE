<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ALL users</title>
    <style>
      table,
      tr,
      th,
      td {
        border: 1px solid black;
      }
    </style>
  </head>
  <body>
    <h1>USERS DETAILS</h1>
    <hr />
    <hr />
    <br />
    <center>
      <table>
        <tr>
          <th>ID</th>
          <th>USERNAME</th>
          <th>EMAIL</th>
        </tr>
        <% for(user of users){%>
    <tr>
        <td><%=user.id%></td>
        <td><%=user.username%></td>
        <td><%=user.email%></td>
        <td><form method="GET" action="/users/<%=user.id%>/edit"><button>Edit</button></form></td>
    </tr>
<%}%>
      </table>
    </center>
  </body>
</html>

