<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <link rel="stylesheet" href="/style.css">
    <title>Mini Whatsapp</title>
</head>
<body>
    <h2>All Chats</h2>
    <form method="GET" action="/chats/new">
        <button>New Chat</button>
    </form>
    <%for(let chat of chats){ %>
    <div class="chat">
        <p>From : <i><%=chat.from%></i></p>
        <div class="msg">
            <p><%=chat.msg%></p>
        </div>
        <p>Received by : <i><%=chat.to%></i></p>
        <p><%=chat.created_at.toString().split(" ")[4]%></p> <!-- abc_dvc_acd      abc abdf xcvb -->
        <p><%=chat.created_at.toString().split(" ").slice(1,4).join(" ")%></p>
        
    </div>
<%}%>

</body>
</html>

