
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="/style.css">

    <title>Mini WhatsApp</title>
</head>

<body>

    <div class="container">

        <div class="top-bar">
            <div>
                <h2>💬 Mini WhatsApp</h2>
                <p>All Chats</p>
            </div>

            <form method="GET" action="/chats/new">
                <button class="new-chat-btn">+ New Chat</button>
            </form>
        </div>


        <% for(let chat of chats) { %>

            <div class="chat">

                <div class="chat-details">

                    <p class="from">
                        From:
                        <strong><%= chat.from %></strong>
                    </p>

                    <div class="msg">

                        <p><%= chat.msg %></p>

                        <form
                            action="/chats/<%= chat._id %>/edit"
                            method="GET"
                        >
                            <button class="edit-btn">
                                Edit
                            </button>
                        </form>
                        <form
                            action="/chats/<%= chat._id %>?_method=DELETE"
                            method="POST"
                        >
                            <button class="edit-btn">
                               Delete
                            </button>
                        </form>

                    </div>

                    <p class="to">
                        Received by:
                        <strong><%= chat.to %></strong>
                    </p>

                    <div class="time">

                        <span>
                            <%= chat.created_at.toString().split(" ")[4] %>
                        </span>

                        <span>
                            <%= chat.created_at.toString().split(" ").slice(1,4).join(" ") %>
                        </span>

                    </div>

                </div>

            </div>

        <% } %>

    </div>

</body>

</html>

